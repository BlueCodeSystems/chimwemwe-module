<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- SN badge -->
        <TextView
            android:id="@+id/tv_sn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/chimwemwe_primary"
            android:background="@drawable/bg_register_icon"
            android:backgroundTint="#E0F7FA" />

        <!-- Names -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_caregiver_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Caregiver Name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/chimwemwe_text_primary" />

            <TextView
                android:id="@+id/tv_child_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Child Name"
                android:textSize="12sp"
                android:textColor="@color/chimwemwe_text_secondary" />

        </LinearLayout>

        <!-- Sessions completed badge -->
        <TextView
            android:id="@+id/tv_sessions_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="0/14"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/chimwemwe_primary" />

        <!-- Edit -->
        <ImageView
            android:id="@+id/btn_edit_participant"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/edit_icon"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/chimwemwe_text_secondary" />

        <!-- Delete -->
        <ImageView
            android:id="@+id/btn_delete_participant"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/baseline_delete_24"
            android:clickable="true"
            android:focusable="true"
            app:tint="#EF4444" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
