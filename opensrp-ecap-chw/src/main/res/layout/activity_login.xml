<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/canvasSV"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true">

    <RelativeLayout
        android:id="@+id/login_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- ══════════ TOP — branding ══════════ -->
        <LinearLayout
            android:id="@+id/top_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="40dp"
            android:paddingBottom="28dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/chimwemwe_header_bg">

            <ImageView
                android:id="@+id/login_logo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/chimwemwe"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/logo" />

            <TextView
                android:id="@+id/login_title_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/login_build_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_version"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- ══════════ MIDDLE — login form ══════════ -->
        <LinearLayout
            android:id="@+id/middle_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/top_section"
            android:orientation="vertical"
            android:background="@drawable/bg_login_form_card"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to continue"
                android:textColor="@color/chimwemwe_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your credentials below"
                android:textColor="@color/chimwemwe_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/login_user_name_edit_text"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_login_field"
                android:hint="@string/username"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:lines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/chimwemwe_text_primary"
                android:textColorHint="#A8B2BB"
                android:textCursorDrawable="@null"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/login_password_edit_text"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_field"
                android:hint="@string/password"
                android:imeActionId="@integer/login"
                android:inputType="textPassword"
                android:lines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/chimwemwe_text_primary"
                android:textColorHint="#A8B2BB"
                android:textCursorDrawable="@null"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <CheckBox
                    android:id="@+id/login_show_password_checkbox"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:button="@drawable/white_checkbox_bg_selector" />

                <TextView
                    android:id="@+id/login_show_password_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/show_password_text"
                    android:textColor="@color/chimwemwe_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/login_login_btn"
                android:onClick="onClick"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_login_btn_chimwemwe"
                android:text="@string/login_text"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

        </LinearLayout>

        <!-- ══════════ BOTTOM — partner / funder logos ══════════ -->
        <LinearLayout
            android:id="@+id/bottom_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/middle_section"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supported by"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/opensrp_logo_image_view"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:src="@drawable/coat_of_arms_of_zambia_ecap" />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>
