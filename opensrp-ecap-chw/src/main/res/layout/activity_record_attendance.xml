<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chimwemwe_surface">

    <!-- ── Toolbar ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/chimwemwe_header_bg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="#FFFFFF"
            app:navigationIconTint="#FFFFFF"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Session info card ── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <!-- Single child wrapping all rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <!-- Session label + date row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_session_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session 1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/chimwemwe_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Record who attended this session"
                        android:textSize="11sp"
                        android:textColor="@color/chimwemwe_text_secondary" />

                </LinearLayout>

                <!-- Date -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session Date"
                        android:textSize="10sp"
                        android:textColor="@color/chimwemwe_text_secondary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/et_session_date"
                        android:layout_width="120dp"
                        android:layout_height="38dp"
                        android:textSize="13sp"
                        android:textColor="@color/chimwemwe_text_primary"
                        android:background="@drawable/bg_login_field"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- GPS and signature are no longer shown directly on this card.
                 GPS is captured on the household service form instead, and the
                 primary caregiver's signature is captured via a modal dialog
                 that the "Save Attendance" button opens before saving. -->


        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ── Search bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_action_search"
            android:layout_marginEnd="8dp"
            app:tint="@color/chimwemwe_text_secondary"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/et_search_participant"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="Search participant…"
            android:textSize="13sp"
            android:textColor="@color/chimwemwe_text_primary"
            android:textColorHint="#A8B2BB"
            android:background="@android:color/transparent"
            android:inputType="textPersonName"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingStart="0dp" />

    </LinearLayout>

    <!-- ── Column headers ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="68dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="PARTICIPANT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/chimwemwe_text_secondary"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CAREGIVER"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/chimwemwe_text_secondary"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CHILD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/chimwemwe_text_secondary"
            android:letterSpacing="0.08"
            android:gravity="center" />

    </LinearLayout>

    <!-- ── Attendance list ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_attendance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- ── Save button ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_save_attendance"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Attendance"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_login_btn_chimwemwe" />

    </LinearLayout>

</LinearLayout>
