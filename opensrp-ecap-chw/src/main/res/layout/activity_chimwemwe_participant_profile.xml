<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chimwemwe_surface">

    <!-- ── App bar ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/chimwemwe_header_bg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="#FFFFFF"
            app:navigationIconTint="#FFFFFF"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <!-- ── Profile hero ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- Caregiver name -->
            <TextView
                android:id="@+id/tv_caregiver_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Child name -->
            <TextView
                android:id="@+id/tv_child_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#CCffffff"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Badges row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_sessions_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_pill_translucent"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ovc_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_chip_danger"
                    android:text="OVC Enrolled"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- Session progress strip -->
        <ProgressBar
            android:id="@+id/pb_sessions_profile"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="14"
            android:progress="0"
            android:progressDrawable="@drawable/progress_sessions_header" />

        <!-- ── Tabs ── -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabMaxWidth="0dp"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabSelectedTextColor="@color/chimwemwe_primary"
            app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white"
            app:tabTextColor="#E6FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Content ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ══ Tab 0: Details ════════════════════════ -->
                <LinearLayout
                    android:id="@+id/tab_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp">

                    <!-- Child details card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Section label -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="10dp">

                                <View
                                    android:layout_width="3dp"
                                    android:layout_height="16dp"
                                    android:background="@color/chimwemwe_primary"
                                    android:layout_marginEnd="10dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CHILD DETAILS"
                                    android:textColor="@color/chimwemwe_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />

                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:background="@color/chimwemwe_surface" />

                            <!-- Fields -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp">

                                <!-- Date of Birth -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Date of Birth"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_child_dob"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- Sex -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Sex"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_child_sex"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- VCA ID -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="VCA ID"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_vca_id"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- Caregiver ID -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Caregiver ID"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_caregiver_id"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Group details card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Section label -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="10dp">

                                <View
                                    android:layout_width="3dp"
                                    android:layout_height="16dp"
                                    android:background="@color/chimwemwe_primary"
                                    android:layout_marginEnd="10dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="GROUP DETAILS"
                                    android:textColor="@color/chimwemwe_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />

                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:background="@color/chimwemwe_surface" />

                            <!-- Fields -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp">

                                <!-- Group Name -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Group"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_group_name"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- Hotspot -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Hotspot"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_hotspot_name"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- Province / District -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Province / District"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_province_district"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- Session Location -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Session Location"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_session_location"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- Health Facility -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingBottom="12dp">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Health Facility"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_health_facility"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp"
                                    android:background="@color/chimwemwe_surface" android:layout_marginBottom="12dp"/>

                                <!-- Facilitators -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Facilitators"
                                        android:textColor="@color/chimwemwe_text_secondary"
                                        android:textSize="13sp" />
                                    <TextView
                                        android:id="@+id/tv_facilitators"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:textColor="@color/chimwemwe_text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- ══ Tab 1: Reviews ════════════════════════ -->
                <LinearLayout
                    android:id="@+id/tab_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="80dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_empty_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No reviews recorded yet"
                        android:textColor="@color/chimwemwe_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingTop="32dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

                <!-- ══ Tab 2: Referrals ══════════════════════ -->
                <LinearLayout
                    android:id="@+id/tab_referrals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="80dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_empty_referrals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No referrals recorded yet"
                        android:textColor="@color/chimwemwe_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingTop="32dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_referrals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- FAB — visible on Reviews / Referrals tabs -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_add_white"
            app:backgroundTint="@color/chimwemwe_primary"
            app:tint="#FFFFFF"
            android:contentDescription="Add"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
