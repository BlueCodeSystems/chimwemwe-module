<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ask the primary caregiver to sign in the box below."
        android:textSize="12sp"
        android:textColor="@color/chimwemwe_text_secondary"
        android:layout_marginBottom="8dp" />

    <com.github.gcacace.signaturepad.views.SignaturePad
        android:id="@+id/dialog_signature_pad"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_login_field" />

    <!-- GPS capture block — visually mirrors the type:gps widget on the
         household service form: vertical field-style block with a small
         label, a filled primary-colored "Record GPS" button, and a readout
         beneath it that fills in once the worker captures a fix. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Session location"
        android:textColor="@color/chimwemwe_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_location_capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Record GPS"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/chimwemwe_primary"
        app:cornerRadius="4dp" />

    <TextView
        android:id="@+id/dialog_location_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Not captured yet"
        android:textColor="@color/chimwemwe_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/dialog_signature_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textAllCaps="false"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/dialog_signature_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false"
            style="?attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/dialog_signature_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/chimwemwe_primary"
            style="?attr/borderlessButtonStyle" />

    </LinearLayout>

</LinearLayout>
