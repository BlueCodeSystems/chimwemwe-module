<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Avatar circle with initials -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tv_initials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="?"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Participant names -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_caregiver_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caregiver"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/chimwemwe_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_child_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Child"
            android:textSize="11sp"
            android:textColor="@color/chimwemwe_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Caregiver attendance -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caregiver"
            android:textSize="10sp"
            android:textColor="@color/chimwemwe_text_secondary"
            android:layout_marginBottom="3dp" />

        <Spinner
            android:id="@+id/spinner_caregiver"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_login_field"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

    </LinearLayout>

    <!-- Child attendance -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Child"
            android:textSize="10sp"
            android:textColor="@color/chimwemwe_text_secondary"
            android:layout_marginBottom="3dp" />

        <Spinner
            android:id="@+id/spinner_child"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_login_field"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

    </LinearLayout>

</LinearLayout>
