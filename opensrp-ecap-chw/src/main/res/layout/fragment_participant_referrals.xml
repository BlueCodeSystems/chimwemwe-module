<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No referrals recorded yet"
        android:textColor="@color/chimwemwe_text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <!-- paddingBottom + clipToPadding=false reserve space for the floating
         ExtendedFAB so the last row can scroll up above it and stay visible.
         88dp ~= FAB height (56) + bottom margin (20) + breathing room. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="88dp"
        android:clipToPadding="false" />

</LinearLayout>

